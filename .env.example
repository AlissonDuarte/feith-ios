# URL base da API. Precisa terminar em /api e NAO pode ser localhost quando o
# app roda num aparelho fisico — o telefone resolveria para ele mesmo.
# Use o IP da maquina na LAN em dev, e o dominio em producao.
#
# dev  : http://192.168.0.10:8000/api
# prod : https://feith.space/api
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Google Sign-In. Ambos vem do mesmo projeto no Google Cloud Console
# (APIs e servicos > Credenciais). Deixe em branco para desligar o login com
# Google: o botao some da tela e o build segue normalmente.
#
# WEB: o mesmo client ID OAuth usado pelo site (GOOGLE_CLIENT_ID do backend).
#      E contra ele que o backend valida o token vindo da web.
# IOS: um client ID do tipo "iOS" criado para o bundle com.feith.app.
#      O URL scheme do callback e derivado dele automaticamente.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# SDK da Meta, para medir instalacoes vindas dos anuncios no Facebook/Instagram.
# Os dois estao em developers.facebook.com > seu app > Configuracoes do app:
# APP_ID em Basico; CLIENT_TOKEN em Avancado. Deixe em branco para desligar:
# o plugin sai do prebuild, a pergunta de rastreamento (ATT) nao aparece e o
# app segue normalmente.
EXPO_PUBLIC_META_APP_ID=
META_CLIENT_TOKEN=

# Produto de assinatura no App Store Connect. Precisa bater exatamente com o
# Product ID cadastrado la; um SKU errado faz getSubscriptions() voltar vazio,
# que e indistinguivel de "Paid Applications Agreement nao aceito".
EXPO_PUBLIC_IAP_SKU=com.feith.app.supporter.monthly

# Dominio da web, usado para montar o link compartilhavel e para os Universal
# Links. Sem barra no final.
EXPO_PUBLIC_WEB_URL=https://feith.space

GOOGLE_SERVICES_JSON=./google-services.json

# PostHog product analytics. Both values are embedded into the Expo build.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com